---
import { LISTINGS_URL, RESIDENT_PORTAL_URL, RENTREDI_REFERRAL_URL } from '../links';
---

<footer class="site-footer">
	<div class="container">
		<div>
			<p class="tagline">Tacoma Tipton</p>
			<p>Single-family residential real estate across the Midwest.</p>
		</div>
		<div class="footer-meta">
			<p>&copy; 2026 Tacoma Tipton</p>
			<p>
				<a href={LISTINGS_URL} target="_blank" rel="noopener">Available homes</a> &middot; <a
					href={RESIDENT_PORTAL_URL}
					target="_blank"
					rel="noopener">Resident portal</a
				> &middot; <a href="/#contact">Contact</a> &middot; <a href="/privacy/">Privacy</a>
			</p>
			<p class="powered">
				Listings and rent payments powered by <a href={RENTREDI_REFERRAL_URL} target="_blank" rel="sponsored noopener">RentRedi</a>
			</p>
		</div>
		<p class="eho">
			<svg viewBox="0 0 32 32" width="30" height="30" aria-hidden="true">
				<path d="M16 3 2 13v3h3v13h22V16h3v-3Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
				<path d="M10 17h12M10 22h12" stroke="currentColor" stroke-width="2.4" />
			</svg>
			<span>
				<strong>Equal Housing Opportunity.</strong> We do not discriminate on the basis of race, color, religion, sex,
				disability, familial status, national origin or any other status protected by federal, state or local law.
			</span>
		</p>
	</div>
</footer>
