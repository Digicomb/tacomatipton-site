---
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { LISTINGS_URL } from '../links';
---

<header class="site-header">
	<div class="container">
		<a class="brand" href="/">
			<Image src={logo} alt="" width={34} height={34} />
			<span>Tacoma Tipton</span>
		</a>
		<nav class="nav" aria-label="Main">
			<a href="/#about">About</a>
			<a href="/#renting">Renting</a>
			<a href="/#residents">Residents</a>
			<a href="/#faq">FAQ</a>
			<a href="/#contact">Contact</a>
			<a class="btn btn-primary" href={LISTINGS_URL} target="_blank" rel="noopener">
				<span class="nav-long">Available homes</span><span class="nav-short">Homes</span>
			</a>
		</nav>
	</div>
</header>
