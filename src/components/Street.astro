---
// Hero art: a row of single-family homes at dusk, porch lights on.
const ground = 330;

// x, width, wall height, roof height, which windows are lit, chimney
const houses = [
	{ x: 40, w: 120, h: 70, roof: 48, lit: [true, false], chimney: false },
	{ x: 230, w: 150, h: 86, roof: 56, lit: [true, true], chimney: true },
	{ x: 455, w: 110, h: 64, roof: 44, lit: [false, true], chimney: false },
	{ x: 645, w: 170, h: 92, roof: 62, lit: [true, true], chimney: true },
	{ x: 885, w: 120, h: 70, roof: 48, lit: [true, false], chimney: false },
	{ x: 1080, w: 150, h: 82, roof: 54, lit: [false, true], chimney: true },
	{ x: 1295, w: 120, h: 70, roof: 50, lit: [true, true], chimney: false },
];

const trees = [
	{ x: 190, r: 26 },
	{ x: 412, r: 22 },
	{ x: 605, r: 28 },
	{ x: 845, r: 24 },
	{ x: 1043, r: 26 },
	{ x: 1258, r: 22 },
	{ x: 1430, r: 28 },
];

const lit = '#f0c46a';
const dark = '#1d332b';
const silhouette = '#10201a';
---

<svg class="street" viewBox="0 0 1440 360" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
	<path d="M0 248C240 188 480 230 720 204C960 178 1200 226 1440 192V360H0Z" fill="#24423a" />
	<path d="M0 296C300 266 600 300 900 280C1150 264 1300 286 1440 274V360H0Z" fill="#1a332c" />

	{
		trees.map((t) => (
			<g fill="#0f1e18">
				<rect x={t.x - 3} y={ground - t.r * 1.2} width="6" height={t.r * 1.2} />
				<ellipse cx={t.x} cy={ground - t.r * 1.7} rx={t.r} ry={t.r * 1.15} />
			</g>
		))
	}

	{
		houses.map((h) => {
			const top = ground - h.h;
			const winW = Math.round(h.w * 0.18);
			const winH = Math.round(h.h * 0.3);
			const winY = top + Math.round(h.h * 0.22);
			const doorW = Math.round(h.w * 0.16);
			const doorH = Math.round(h.h * 0.5);
			return (
				<g>
					{h.chimney && <rect x={h.x + h.w * 0.68} y={top - h.roof * 0.85} width="14" height={h.roof * 0.6} fill={silhouette} />}
					<path d={`M${h.x - 8} ${top}L${h.x + h.w / 2} ${top - h.roof}L${h.x + h.w + 8} ${top}Z`} fill={silhouette} />
					<rect x={h.x} y={top} width={h.w} height={h.h} fill={silhouette} />
					<rect x={h.x + h.w * 0.14} y={winY} width={winW} height={winH} fill={h.lit[0] ? lit : dark} />
					<rect x={h.x + h.w * 0.86 - winW} y={winY} width={winW} height={winH} fill={h.lit[1] ? lit : dark} />
					<rect x={h.x + (h.w - doorW) / 2} y={ground - doorH} width={doorW} height={doorH} fill={dark} />
					<circle cx={h.x + h.w / 2} cy={ground - doorH - 7} r="2.5" fill={lit} />
				</g>
			);
		})
	}

	<rect x="0" y={ground} width="1440" height={360 - ground} fill="#0d1a15" />
	<rect x="0" y={ground + 8} width="1440" height="3" fill="#24392f" />
</svg>
