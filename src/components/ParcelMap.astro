---
// Hero art: an abstract parcel map. Blocks of lots on a street grid, with
// some lots highlighted to suggest a portfolio. CSS fades it out behind the hero text.
const blockW = 168;
const blockH = 112;
const street = 26;
const cols = 9;
const rows = 6;
const lotsPerRow = 4;

// Small deterministic random so the map is the same on every build.
let seed = 7;
const rand = () => {
	seed = (seed * 16807) % 2147483647;
	return seed / 2147483647;
};

const lots: { x: number; y: number; w: number; h: number; owned: boolean }[] = [];
for (let r = 0; r < rows; r++) {
	for (let c = 0; c < cols; c++) {
		const bx = c * (blockW + street) + (r % 2) * 40 - 20;
		const by = r * (blockH + street) + 10;
		const w = blockW / lotsPerRow;
		const h = blockH / 2;
		for (let i = 0; i < lotsPerRow; i++) {
			for (let j = 0; j < 2; j++) {
				lots.push({ x: bx + i * w, y: by + j * h, w, h, owned: rand() < 0.11 });
			}
		}
	}
}
---

<svg class="parcel-map" viewBox="0 0 1720 840" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
	<g>
		{
			lots.map((l) => (
				<rect
					x={l.x + 2}
					y={l.y + 2}
					width={l.w - 4}
					height={l.h - 4}
					rx="2"
					class={l.owned ? 'lot owned' : 'lot'}
				/>
			))
		}
	</g>
</svg>
