---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ParcelMap from '../components/ParcelMap.astro';
import ContactForm from '../components/ContactForm.astro';

const pillars = [
	{
		title: 'Acquisition',
		body: 'We identify and acquire single-family homes in stable, established Midwest neighborhoods.',
	},
	{
		title: 'Renovation',
		body: 'Each property is brought to a consistent standard before it is offered for lease.',
	},
	{
		title: 'Leasing',
		body: 'Applicants are screened against clear criteria and sign standardized, straightforward leases.',
	},
	{
		title: 'Management',
		body: 'Maintenance, resident support and property oversight are handled by our management team.',
	},
];

const features = [
	{
		title: 'Single-family living',
		body: 'Detached homes with private yards and driveways in established residential neighborhoods.',
		icon: 'M3 11 12 4l9 7M5 10v10h14V10M10 20v-5h4v5',
	},
	{
		title: 'Move-in ready',
		body: 'Every home is inspected and renovated to our standard before a new lease begins.',
		icon: 'M9 12l2 2 4-4M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6Z',
	},
	{
		title: 'Maintenance support',
		body: 'Submit repair requests online any time. Our team schedules and tracks each request to completion.',
		icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.1L3.5 17.2a1.8 1.8 0 0 0 2.6 2.6l5.8-5.8a4 4 0 0 0 5.1-5.4l-2.5 2.5-2.4-.6-.6-2.4Z',
	},
	{
		title: 'Clear lease terms',
		body: 'Standardized leases with straightforward terms, reviewed with you before you sign.',
		icon: 'M7 3h7l5 5v13H7ZM14 3v5h5M10 13h6M10 17h6',
	},
];

const steps = [
	{
		title: 'Inquire',
		body: 'Tell us the area, home size and move-in date you have in mind.',
	},
	{
		title: 'Tour',
		body: 'Our leasing team schedules a showing of available homes that fit your needs.',
	},
	{
		title: 'Apply',
		body: 'Complete a rental application. We’ll confirm the requirements and respond promptly.',
	},
	{
		title: 'Sign your lease',
		body: 'Review and sign your lease, then schedule your move-in.',
	},
];

const residentLinks = [
	{
		title: 'Maintenance requests',
		body: 'Report a repair need, including the location in the home and the best times for access.',
		cta: 'Submit a request',
		topic: 'Maintenance',
	},
	{
		title: 'Lease and account questions',
		body: 'Rent, renewals, move-out and other questions about your lease.',
		cta: 'Contact us',
		topic: 'Resident',
	},
];

const faqs = [
	{
		q: 'Where are your properties located?',
		a: 'Our portfolio is located in the Midwest. Tell us the area you’re interested in and our leasing team will let you know what’s available.',
	},
	{
		q: 'Do you have homes available now?',
		a: 'Availability changes throughout the year. Send an inquiry with your preferred area, home size and move-in date, and we’ll follow up with current options.',
	},
	{
		q: 'What are the application requirements?',
		a: 'Applications typically include identity verification, a credit and background check, and proof of income. We’ll confirm the requirements for the specific home.',
	},
	{
		q: 'Are pets allowed?',
		a: 'Pet policies are set by property. Ask about a specific home for details. Assistance animals are accommodated in accordance with fair housing law.',
	},
	{
		q: 'How are repairs handled?',
		a: 'Residents submit maintenance requests through this website, and our team reviews and schedules each one. For emergencies, follow the instructions in the Residents section.',
	},
	{
		q: 'Who is responsible for utilities and lawn care?',
		a: 'Responsibilities vary by property and are defined in each lease.',
	},
];

const iconProps = {
	width: 22,
	height: 22,
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-width': 1.8,
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
};
---

<Base
	title="Tacoma Tipton | Single-family rental homes across the Midwest"
	description="Tacoma Tipton acquires, renovates and manages single-family rental homes across the Midwest. Find a rental home or submit a maintenance request."
>
	<SiteHeader />

	<main>
		<section class="hero">
			<ParcelMap />
			<div class="container hero-body">
				<span class="eyebrow">Single-family residential real estate</span>
				<h1>Single-family rental homes across the Midwest.</h1>
				<p>
					Tacoma Tipton acquires, renovates and manages single-family rental homes in established Midwest
					neighborhoods, with professional leasing and maintenance for every resident.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href="#contact" data-topic="Renting">Find a rental</a>
					<a class="btn btn-ghost" href="#residents">Resident services</a>
				</div>
			</div>
		</section>

		<section class="section" id="about">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">What we do</span>
					<h2>An owner-operator of single-family rental housing</h2>
					<p class="lead">
						We handle every stage of ownership, from acquisition through day-to-day management, so standards stay
						consistent across our portfolio.
					</p>
				</div>
				<div class="pillars">
					{
						pillars.map((p, i) => (
							<div class="pillar">
								<span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section section-soft" id="renting">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Renting with Tacoma Tipton</span>
					<h2>Professionally managed homes</h2>
					<p class="lead">
						Our residents get the space and privacy of a single-family home, backed by a dedicated management team.
					</p>
				</div>
				<div class="cards">
					{
						features.map((f) => (
							<div class="card">
								<div class="icon-badge" aria-hidden="true">
									<svg {...iconProps}>
										<path d={f.icon} />
									</svg>
								</div>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section" id="how">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">How to rent</span>
					<h2>From inquiry to move-in</h2>
					<p class="lead">
						Homes become available throughout the year. Send an inquiry and our leasing team will follow up with
						options that match what you’re looking for.
					</p>
				</div>
				<ol class="steps" role="list">
					{
						steps.map((s, i) => (
							<li class="step">
								<span class="step-num">STEP {i + 1}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="section section-dark" id="residents">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Residents</span>
					<h2>Resident services</h2>
					<p class="lead">Current residents can submit maintenance requests and questions to our team online.</p>
				</div>
				<div class="resident-grid">
					{
						residentLinks.map((r) => (
							<div class="resident-card">
								<h3>{r.title}</h3>
								<p>{r.body}</p>
								<a class="btn btn-primary" href="#contact" data-topic={r.topic}>
									{r.cta}
								</a>
							</div>
						))
					}
					<div class="resident-card emergency">
						<h3>Emergencies</h3>
						<p>
							If you smell gas, see fire or smoke, or anyone is in danger,
							<strong>leave the home and call 911 first.</strong>
						</p>
						<p>
							For urgent issues such as no heat in winter, a major water leak or a loss of power, call the emergency
							maintenance number in your lease. Do not use the online form for emergencies.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="faq">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Questions</span>
					<h2>Frequently asked questions</h2>
				</div>
				<div class="faq">
					{
						faqs.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p>{f.a}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="section cta" id="contact">
			<div class="container">
				<span class="eyebrow">Contact</span>
				<h2>Get in touch</h2>
				<p class="lead">
					Prospective residents, current residents and others can reach our team here. We typically respond within one
					business day.
				</p>
				<ContactForm />
			</div>
		</section>
	</main>

	<SiteFooter />
</Base>

<script>
	// Buttons around the page preselect the form's topic.
	document.querySelectorAll<HTMLAnchorElement>('a[data-topic]').forEach((link) => {
		link.addEventListener('click', () => {
			const topic = document.getElementById('cf-topic') as HTMLSelectElement | null;
			if (topic && link.dataset.topic) topic.value = link.dataset.topic;
			document.dispatchEvent(new Event('contact:preset'));
		});
	});
</script>
