---
import Base from '../layouts/Base.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ParcelMap from '../components/ParcelMap.astro';
import ContactForm from '../components/ContactForm.astro';
import { LISTINGS_URL, RESIDENT_PORTAL_URL } from '../links';

const pillars = [
	{
		title: 'Acquisition',
		body: 'We identify and acquire single-family homes in stable, established Midwest neighborhoods.',
	},
	{
		title: 'Renovation',
		body: 'Each property is brought to a consistent standard before it is offered for lease.',
	},
	{
		title: 'Leasing',
		body: 'Applicants are screened against clear criteria and sign standardized, straightforward leases.',
	},
	{
		title: 'Management',
		body: 'Maintenance, resident support and property oversight are handled by our management team.',
	},
];

const features = [
	{
		title: 'Single-family living',
		body: 'Detached homes with private yards and driveways in established residential neighborhoods.',
		icon: 'M3 11 12 4l9 7M5 10v10h14V10M10 20v-5h4v5',
	},
	{
		title: 'Move-in ready',
		body: 'Every home is inspected and renovated to our standard before a new lease begins.',
		icon: 'M9 12l2 2 4-4M12 3l7 3v5c0 4.5-3 8.5-7 10-4-1.5-7-5.5-7-10V6Z',
	},
	{
		title: 'Maintenance support',
		body: 'Submit repair requests online any time. Our team schedules and tracks each request to completion.',
		icon: 'M14.7 6.3a4 4 0 0 0-5.4 5.1L3.5 17.2a1.8 1.8 0 0 0 2.6 2.6l5.8-5.8a4 4 0 0 0 5.1-5.4l-2.5 2.5-2.4-.6-.6-2.4Z',
	},
	{
		title: 'Clear lease terms',
		body: 'Standardized leases with straightforward terms, reviewed with you before you sign.',
		icon: 'M7 3h7l5 5v13H7ZM14 3v5h5M10 13h6M10 17h6',
	},
];

const steps = [
	{
		title: 'Browse homes',
		body: 'See current listings with rent, bedrooms and features on our available homes page.',
	},
	{
		title: 'Tour',
		body: 'Request a showing of the homes that fit your needs and our leasing team will schedule it.',
	},
	{
		title: 'Apply online',
		body: 'Complete a secure online rental application. We’ll review it and respond promptly.',
	},
	{
		title: 'Sign your lease',
		body: 'Review and sign your lease, then schedule your move-in.',
	},
];


const faqs = [
	{
		q: 'Where are your properties located?',
		a: 'Our portfolio is located in the Midwest. Tell us the area you’re interested in and our leasing team will let you know what’s available.',
	},
	{
		q: 'Do you have homes available now?',
		a: 'Current listings are on our available homes page. Availability changes throughout the year, so if nothing fits today, send us an inquiry and we’ll follow up as homes open up.',
		link: { href: LISTINGS_URL, label: 'View available homes' },
	},
	{
		q: 'How do I apply?',
		a: 'Choose a home on our available homes page and select Apply Now to complete a secure online application.',
		link: { href: LISTINGS_URL, label: 'Go to available homes' },
	},
	{
		q: 'What are the application requirements?',
		a: 'Applications typically include identity verification, a credit and background check, and proof of income. Requirements for each home are shown with its listing.',
	},
	{
		q: 'Are pets allowed?',
		a: 'Pet policies are set by property. Ask about a specific home for details. Assistance animals are accommodated in accordance with fair housing law.',
	},
	{
		q: 'How do I pay rent?',
		a: 'Residents pay rent online through the resident portal or the RentRedi mobile app, by bank account or card, with optional autopay.',
		link: { href: RESIDENT_PORTAL_URL, label: 'Log in to the resident portal' },
	},
	{
		q: 'How are repairs handled?',
		a: 'Residents submit maintenance requests in the resident portal or app, where they can add photos or video and track progress. Our team reviews and schedules each one. For emergencies, follow the instructions in the Residents section.',
	},
	{
		q: 'Who is responsible for utilities and lawn care?',
		a: 'Responsibilities vary by property and are defined in each lease.',
	},
];

const iconProps = {
	width: 22,
	height: 22,
	viewBox: '0 0 24 24',
	fill: 'none',
	stroke: 'currentColor',
	'stroke-width': 1.8,
	'stroke-linecap': 'round',
	'stroke-linejoin': 'round',
};
---

<Base
	title="Tacoma Tipton | Single-family rental homes across the Midwest"
	description="Tacoma Tipton acquires, renovates and manages single-family rental homes across the Midwest. View available homes, apply online or log in to the resident portal."
>
	<SiteHeader />

	<main>
		<section class="hero">
			<ParcelMap />
			<div class="container hero-body">
				<span class="eyebrow">Single-family residential real estate</span>
				<h1>Single-family rental homes across the Midwest.</h1>
				<p>
					Tacoma Tipton acquires, renovates and manages single-family rental homes in established Midwest
					neighborhoods, with professional leasing and maintenance for every resident.
				</p>
				<div class="hero-actions">
					<a class="btn btn-primary" href={LISTINGS_URL} target="_blank" rel="noopener">View available homes</a>
					<a class="btn btn-ghost" href="#residents">Resident services</a>
				</div>
			</div>
		</section>

		<section class="section" id="about">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">What we do</span>
					<h2>An owner-operator of single-family rental housing</h2>
					<p class="lead">
						We handle every stage of ownership, from acquisition through day-to-day management, so standards stay
						consistent across our portfolio.
					</p>
				</div>
				<div class="pillars">
					{
						pillars.map((p, i) => (
							<div class="pillar">
								<span class="pillar-num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{p.title}</h3>
								<p>{p.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section section-soft" id="renting">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Renting with Tacoma Tipton</span>
					<h2>Professionally managed homes</h2>
					<p class="lead">
						Our residents get the space and privacy of a single-family home, backed by a dedicated management team.
					</p>
				</div>
				<div class="cards">
					{
						features.map((f) => (
							<div class="card">
								<div class="icon-badge" aria-hidden="true">
									<svg {...iconProps}>
										<path d={f.icon} />
									</svg>
								</div>
								<h3>{f.title}</h3>
								<p>{f.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section" id="how">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">How to rent</span>
					<h2>From inquiry to move-in</h2>
					<p class="lead">
						Browse current listings and apply online. Homes become available throughout the year, so check back
						often or send us an inquiry.
					</p>
				</div>
				<ol class="steps" role="list">
					{
						steps.map((s, i) => (
							<li class="step">
								<span class="step-num">STEP {i + 1}</span>
								<h3>{s.title}</h3>
								<p>{s.body}</p>
							</li>
						))
					}
				</ol>
				<div class="section-actions">
					<a class="btn btn-primary" href={LISTINGS_URL} target="_blank" rel="noopener">View available homes</a>
					<a class="btn btn-outline" href="#contact" data-topic="Renting">Ask our leasing team</a>
				</div>
			</div>
		</section>

		<section class="section section-dark" id="residents">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Residents</span>
					<h2>Resident services</h2>
					<p class="lead">
						Current residents manage everything in the resident portal: rent, maintenance requests and lease details.
					</p>
				</div>
				<div class="resident-grid">
					<div class="resident-card">
						<h3>Resident portal</h3>
						<ul class="resident-list" role="list">
							<li>Pay rent by bank account or card</li>
							<li>Set up autopay</li>
							<li>Submit and track maintenance requests</li>
							<li>View your lease and messages</li>
						</ul>
						<a class="btn btn-primary" href={RESIDENT_PORTAL_URL} target="_blank" rel="noopener">Log in</a>
					</div>
					<div class="resident-card">
						<h3>Questions for our team</h3>
						<p>Renewals, move-out or anything else about your lease? Send us a message and we’ll follow up.</p>
						<a class="btn btn-primary" href="#contact" data-topic="Resident">Contact us</a>
					</div>
					<div class="resident-card emergency">
						<h3>Emergencies</h3>
						<p>
							If you smell gas, see fire or smoke, or anyone is in danger, <strong>leave the home and call 911 first.</strong>
						</p>
						<p>
							For urgent issues such as no heat in winter, a major water leak or a loss of power, call the emergency
							maintenance number in your lease. Do not use the online form for emergencies.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="section" id="faq">
			<div class="container">
				<div class="section-head">
					<span class="eyebrow">Questions</span>
					<h2>Frequently asked questions</h2>
				</div>
				<div class="faq">
					{
						faqs.map((f) => (
							<details>
								<summary>{f.q}</summary>
								<p>
									{f.a}
									{f.link && (
										<>
											{' '}
											<a href={f.link.href} target="_blank" rel="noopener">
												{f.link.label}
											</a>
										</>
									)}
								</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="section cta" id="contact">
			<div class="container">
				<span class="eyebrow">Contact</span>
				<h2>Get in touch</h2>
				<p class="lead">
					Prospective residents, current residents and others can reach our team here. We typically respond within one
					business day.
				</p>
				<ContactForm />
			</div>
		</section>
	</main>

	<SiteFooter />
</Base>

<script>
	// Buttons around the page preselect the form's topic.
	document.querySelectorAll<HTMLAnchorElement>('a[data-topic]').forEach((link) => {
		link.addEventListener('click', () => {
			const topic = document.getElementById('cf-topic') as HTMLSelectElement | null;
			if (topic && link.dataset.topic) topic.value = link.dataset.topic;
			document.dispatchEvent(new Event('contact:preset'));
		});
	});
</script>
